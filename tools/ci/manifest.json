    {
      "id": "sadd-selftest",
      "owner": "SADD",
      "kind": "docs-tool",
      "argv": [
        "node",
        "--test",
        "tools/sadd/pack.test.mjs",
        "tools/sadd/current.test.mjs",
        "tools/sadd/reservations.test.mjs",
        "tools/sadd/cardiff.test.mjs",
        "tools/sadd/audit.test.mjs",
        "tools/sadd/stats.test.mjs",
        "tools/sadd/structure.test.mjs"
