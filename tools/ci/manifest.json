      "owner": "CORE-75",
      "argv": [
        "node",
        "tools/sadd/reservations.mjs"
      ]
    },
    {
      "id": "check-deps",
      "owner": "CORE-69",
      "argv": [
        "python",
        "tools/ci/check_deps.py",
        "--root",
        "."
      ]
    },
    {
      "id": "check-privacy",
      "owner": "CORE-69",
      "argv": [
        "python",
        "tools/ci/check_privacy.py",
        "--root",
        "."
      ]
    },
    {
      "id": "check-unsafe",
      "owner": "CORE-74",
      "argv": [
        "python",
        "tools/ci/check_unsafe.py",
        "--root",
        "."
      ]
    },
    {
      "id": "check-abi",
      "owner": "CORE-74",
      "argv": [
        "python",
        "tools/ci/check_abi.py",
        "--root",
        ".",
        "--base-ref",
        "abi-v1.0.0"
      ]
    },
    {
      "id": "check-errors",
      "owner": "CORE-74",
      "argv": [
