      "argv": [
        "node",
        "tools/DTOcheck/run.mjs",
        "--strict"
      ]
    },
    {
      "id": "dtocheck-selftest",
      "owner": "SADD",
      "kind": "docs-tool",
      "argv": [
        "node",
        "--test",
        "tools/DTOcheck/cards.test.mjs",
        "tools/DTOcheck/dto.test.mjs",
        "tools/DTOcheck/layout.test.mjs",
        "tools/DTOcheck/xref.test.mjs",
        "tools/DTOcheck/registry.test.mjs",
        "tools/DTOcheck/yaml-lite.test.mjs"
      ]
    },
    {
      "id": "dto-drift",
      "owner": "CORE-67",
      "argv": [
        "python",
        "tools/ci/gen_dto.py",
