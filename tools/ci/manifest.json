      "owner": "CORE-41",
      "argv": [
        "python",
        "tools/ci/core_sources.py",
        "--root",
        ".",
        "--out",
        "build/coverage/core-sources.json"
      ]
    },
    {
      "id": "maint-report",
      "owner": "CORE-71",
      "argv": [
        "python",
        "tools/ci/maint_report.py",
        "--root",
        ".",
        "--out",
        "build/maint.md",
        "--lcov",
        "build/coverage/core.lcov",
        "--core-sources",
        "build/coverage/core-sources.json",
        "--annotations"
      ]
