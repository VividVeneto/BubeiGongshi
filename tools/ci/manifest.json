        "tools/ci/tests/test_gate74_unsafe.py",
        "tools/ci/tests/test_gate74_abi.py",
        "tools/ci/tests/test_gate74_errors.py",
        "tools/ci/tests/test_gate74_entrypoints.py"
      ]
    },
