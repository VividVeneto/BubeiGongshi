                "den": "1"
              },
              {
                "num": "0",
                "den": "1"
              },
              {
                "num": "0",
                "den": "1"
              },
              {
                "num": "0",
                "den": "1"
              },
              {
                "num": "0",
                "den": "1"
              },
              {
                "num": "0",
                "den": "1"
              }
            ]
          },
          "pseudo": []
        }
      },
      "ok": {
        "units": []
      }
    }
