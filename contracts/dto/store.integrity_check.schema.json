{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StoreIntegrityCheckSchema",
  "$defs": {
    "request": {
      "title": "StoreIntegrityCheckRequest",
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,19})$",
          "format": "uint64"
        }
      },
      "required": [
        "handle"
      ],
      "additionalProperties": false
    },
    "ok": {
      "title": "StoreIntegrityCheckOk",
      "$ref": "types.schema.json#/$defs/IntegrityReport"
    }
  },
  "examples": [
    {
      "request": {
        "handle": "281474976710657"
      },
      "ok": {
        "ok": true,
        "sqlite_messages": [
          "ok"
        ],
        "foreign_key_violations": 0,
        "schema_version": 13
      }
    }
  ]
}
