{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountCreateRegisteredSchema",
  "$defs": {
    "request": {
      "title": "AccountCreateRegisteredRequest",
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "email_masked": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        }
      },
      "required": [
        "account_id",
        "email_masked"
      ],
      "additionalProperties": false
    },
    "ok": {
      "title": "AccountCreateRegisteredOk",
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "types.schema.json#/$defs/Profile"
        },
        "db_key": {
          "type": "string",
          "format": "base64",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "x-sensitive": true
        }
      },
      "required": [
        "profile",
        "db_key"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "request": {
        "account_id": "00000000-0000-4000-8000-000000000001",
        "email_masked": "a***"
      },
      "ok": {
        "profile": {
          "profile_id": "00000000-0000-4000-8000-000000000001",
          "db_path": "/fixture/profile.db",
          "logged_out": false,
          "sync_enabled": false,
          "last_used_ms": 0,
          "account_id": "00000000-0000-4000-8000-000000000001",
          "email_masked": "a***"
        },
        "db_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
      }
    }
  ]
}
